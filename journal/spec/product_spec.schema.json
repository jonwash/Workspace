{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.app/schemas/product_spec.schema.json",
  "title": "Echo product spec",
  "description": "Validates the structure of product_spec.yaml. JSON Schema 2020-12.",
  "type": "object",
  "required": ["spec_version", "id", "title", "autonomy", "parameters", "purpose", "scope", "stories", "ux", "interfaces", "evaluation"],
  "additionalProperties": true,
  "properties": {
    "spec_version": { "type": "string" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "autonomy": {
      "type": "object",
      "required": ["level", "allowed_actions", "forbidden_actions"],
      "properties": {
        "level": { "enum": ["assistive", "semi_autonomous", "bounded_autonomous"] },
        "allowed_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "forbidden_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "parameters": {
      "type": "object",
      "required": ["target_languages", "scale", "deployment_environment"],
      "properties": {
        "target_languages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "scale": { "type": "string" },
        "deployment_environment": { "type": "string" }
      }
    },
    "purpose": {
      "type": "object",
      "required": ["problem_statement", "user_value", "non_goals"],
      "properties": {
        "problem_statement": { "type": "string" },
        "user_value": { "type": "string" },
        "non_goals": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in_scope_flows", "security_boundaries"],
      "properties": {
        "in_scope_flows": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "security_boundaries": { "type": "object" }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "story", "priority", "acceptance"],
        "properties": {
          "id": { "type": "string" },
          "story": { "type": "string" },
          "priority": { "enum": ["must", "should", "could"] },
          "acceptance": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "ux": {
      "type": "object",
      "required": ["flows"],
      "properties": {
        "flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "steps"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "steps": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "required": ["openapi"],
      "properties": {
        "openapi": {
          "type": "object",
          "required": ["file"],
          "properties": { "file": { "type": "string" } }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "run"],
            "properties": {
              "name": { "type": "string" },
              "run": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
